    { "text": "inactive", "match": "fragment", "status": "stopped", "from": "extraction model output" },
    { "text": "discontinu", "match": "fragment", "status": "stopped", "from": "stem of discontinue / discontinued / discontinuation" },
    { "text": "no longer", "match": "fragment", "status": "stopped", "from": "extraction model output ('no longer taking')" },
