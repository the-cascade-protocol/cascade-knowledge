{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ns.cascadeprotocol.org/knowledge/v0/product-strength.schema.json",
  "title": "RxNorm clinical or branded drug with its ingredients, strengths and dose form",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "product",
    "components",
    "doseForm",
    "provenance"
  ],
  "properties": {
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "code",
        "display",
        "tty"
      ],
      "properties": {
        "system": {
          "enum": [
            "RXNORM"
          ]
        },
        "code": {
          "type": "string",
          "pattern": "^\\d+$"
        },
        "display": {
          "type": "string",
          "minLength": 1
        },
        "tty": {
          "enum": [
            "SCD",
            "SBD"
          ]
        }
      }
    },
    "clinicalDrug": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "code",
        "display"
      ],
      "properties": {
        "system": {
          "enum": [
            "RXNORM"
          ]
        },
        "code": {
          "type": "string",
          "pattern": "^\\d+$"
        },
        "display": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "code",
        "display"
      ],
      "properties": {
        "system": {
          "enum": [
            "RXNORM"
          ]
        },
        "code": {
          "type": "string",
          "pattern": "^\\d+$"
        },
        "display": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "component",
          "ingredient",
          "strength"
        ],
        "properties": {
          "component": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "system",
              "code",
              "display"
            ],
            "properties": {
              "system": {
                "enum": [
                  "RXNORM"
                ]
              },
              "code": {
                "type": "string",
                "pattern": "^\\d+$"
              },
              "display": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "ingredient": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "system",
              "code",
              "display"
            ],
            "properties": {
              "system": {
                "enum": [
                  "RXNORM"
                ]
              },
              "code": {
                "type": "string",
                "pattern": "^\\d+$"
              },
              "display": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "preciseIngredient": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "system",
              "code",
              "display"
            ],
            "properties": {
              "system": {
                "enum": [
                  "RXNORM"
                ]
              },
              "code": {
                "type": "string",
                "pattern": "^\\d+$"
              },
              "display": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "strength": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "unit"
            ],
            "properties": {
              "value": {
                "type": "string",
                "pattern": "^\\d+(\\.\\d+)?$"
              },
              "unit": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "doseForm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "display"
      ],
      "properties": {
        "system": {
          "enum": [
            "RXNORM"
          ]
        },
        "code": {
          "type": "string",
          "pattern": "^\\d+$"
        },
        "display": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit"
      ],
      "properties": {
        "value": {
          "type": "string",
          "pattern": "^\\d+(\\.\\d+)?$"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "releasePeriod": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit"
      ],
      "properties": {
        "value": {
          "type": "string",
          "pattern": "^\\d+(\\.\\d+)?$"
        },
        "unit": {
          "enum": [
            "HR"
          ]
        }
      }
    },
    "provenance": {
      "$ref": "defs.schema.json#/$defs/provenance"
    }
  }
}
