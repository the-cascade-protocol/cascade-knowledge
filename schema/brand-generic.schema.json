{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ns.cascadeprotocol.org/knowledge/v0/brand-generic.schema.json",
  "title": "Brand name is a tradename of a generic ingredient",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "subject",
    "predicate",
    "object",
    "provenance"
  ],
  "properties": {
    "subject": {
      "allOf": [
        {
          "$ref": "defs.schema.json#/$defs/node"
        },
        {
          "type": "object",
          "required": [
            "system",
            "code",
            "display"
          ],
          "properties": {
            "system": {
              "enum": [
                "RXNORM"
              ]
            }
          }
        }
      ]
    },
    "predicate": {
      "enum": [
        "tradename_of"
      ]
    },
    "object": {
      "allOf": [
        {
          "$ref": "defs.schema.json#/$defs/node"
        },
        {
          "type": "object",
          "required": [
            "system",
            "code",
            "display"
          ],
          "properties": {
            "system": {
              "enum": [
                "RXNORM"
              ]
            }
          }
        }
      ]
    },
    "provenance": {
      "$ref": "defs.schema.json#/$defs/provenance"
    }
  }
}
