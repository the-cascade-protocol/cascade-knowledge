{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ns.cascadeprotocol.org/knowledge/v0/medication-status-lifecycle.schema.json",
  "title": "Medication status code has a lifecycle class (active / stopped / unknown / entered-in-error)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "subject",
    "predicate",
    "object",
    "provenance"
  ],
  "properties": {
    "subject": {
      "allOf": [
        {
          "$ref": "defs.schema.json#/$defs/node"
        },
        {
          "type": "object",
          "required": [
            "system",
            "code",
            "display"
          ],
          "properties": {
            "system": {
              "enum": [
                "FHIR-MEDICATIONREQUEST-STATUS",
                "FHIR-MEDICATIONSTATEMENT-STATUS",
                "FHIR-DATA-ABSENT-REASON"
              ]
            }
          }
        }
      ]
    },
    "predicate": {
      "enum": [
        "has_lifecycle"
      ]
    },
    "object": {
      "allOf": [
        {
          "$ref": "defs.schema.json#/$defs/node"
        },
        {
          "type": "object",
          "required": [
            "system",
            "code",
            "display"
          ],
          "properties": {
            "system": {
              "enum": [
                "CASCADE-MED-LIFECYCLE"
              ]
            },
            "code": {
              "enum": [
                "active",
                "stopped",
                "unknown",
                "entered-in-error"
              ]
            }
          }
        }
      ]
    },
    "provenance": {
      "$ref": "defs.schema.json#/$defs/provenance"
    }
  }
}
